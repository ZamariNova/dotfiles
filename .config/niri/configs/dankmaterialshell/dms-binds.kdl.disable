binds {
    // #"Dark Matter Shell"
    // ======================= DMS (Shell) =========================
    // #"DMS (Shell)"  <-- Niri Keybinds Tag  ======================
    // =============================================================
    Mod+Space hotkey-overlay-title="Application Launcher" { spawn-sh "dms ipc callspotlight toggle"; }
    Mod+V hotkey-overlay-title="Clipboard Manager" { spawn-sh "dms ipc callclipboard toggle"; }
    Mod+M hotkey-overlay-title="Task Manager" { spawn-sh "dms ipc callprocesslist focusOrToggle"; }
    Super+X hotkey-overlay-title="Power Menu: Toggle" { spawn-sh "dms ipc callpowermenu toggle"; }
    Mod+Comma hotkey-overlay-title="Settings" { spawn-sh "dms ipc callsettings focusOrToggle"; }
    Mod+Y hotkey-overlay-title="Browse Wallpapers" { spawn-sh "dms ipc calldankdash wallpaper"; }
    Mod+N hotkey-overlay-title="Notification Center" { spawn-sh "dms ipc callnotifications toggle"; }
    Mod+Shift+N hotkey-overlay-title="Notepad" { spawn-sh "dms ipc callnotepad toggle"; }
    Mod+F1 hotkey-overlay-title="Keybinds Cheatsheet" { spawn-sh "dms ipc callkeybinds toggle niri"; }
    // ====================== DMS (Security) =======================
    // DMS (Security)"  <-- Niri Keybinds Tag  ===================
    // =============================================================
    Mod+Alt+L hotkey-overlay-title="Lock Screen" { spawn-sh "dms ipc calllock lock"; }
    Ctrl+Alt+Delete hotkey-overlay-title="Task Manager" { spawn-sh "dms ipc callprocesslist focusOrToggle"; }

    // ======================= DMS (System) ========================
    // DMS (System)"  <-- Niri Keybinds Tag  =====================
    // =============================================================

    // Media Controls  ----------------------------------------------
    XF86AudioRaiseVolume hotkey-overlay-title="Audio Volume Up" allow-when-locked=true { spawn-sh "dms ipc callaudio increment 3"; }
    XF86AudioLowerVolume hotkey-overlay-title="Audio Volume Down" allow-when-locked=true { spawn-sh "dms ipc callaudio decrement 3"; }
    XF86AudioMute hotkey-overlay-title="Audio Mute" allow-when-locked=true { spawn-sh "dms ipc callaudio mute"; }
    XF86AudioMicMute hotkey-overlay-title="Audio Mute Mic" allow-when-locked=true { spawn-sh "dms ipc callaudio micmute"; }
	XF86AudioPause hotkey-overlay-title="Media Pause" allow-when-locked=true { spawn-sh "dms ipc callmpris playPause"; }
	XF86AudioPlay hotkey-overlay-title="Media Play" allow-when-locked=true { spawn-sh "dms ipc callmpris playPause"; }
	XF86AudioPrev hotkey-overlay-title="Media Previous" allow-when-locked=true { spawn-sh "dms ipc callmpris previous"; }
	XF86AudioNext hotkey-overlay-title="Media Next" allow-when-locked=true { spawn-sh "dms ipc callmpris next"; }
    Ctrl+XF86AudioRaiseVolume hotkey-overlay-title="App Volume Up" allow-when-locked=true { spawn-sh "dms ipc callmpris increment 3"; }
    Ctrl+XF86AudioLowerVolume hotkey-overlay-title="App Volume Down" allow-when-locked=true { spawn-sh "dms ipc callmpris decrement 3"; }

    // Screen Brightness -------------------------------------------
    XF86MonBrightnessUp allow-when-locked=true { spawn-sh "dms ipc callbrightness increment 5 "; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "dms ipc callbrightness decrement 5 "; }


    Mod+Shift+W hotkey-overlay-title="Create window rule" { spawn-sh "dms ipc callwindow-rules toggle"; }
    // === Workspace Management ===
    Ctrl+Shift+R hotkey-overlay-title="Rename Workspace" { spawn-sh "dms ipc callworkspace-rename open"; }
}
