{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "",
    "color": {
      "1": "",
      "2": "",
      "3": "",
      "4": "",
      "5": "",
      "6": "",
      "7": "",
      "8": "",
      "9": "",
    },
    "width": null,
    "height": null,
    "padding": {
      "top": 0,
      "left": 0,
      "right": 4,
    },
    "printRemaining": true,
    "preserveAspectRatio": false,
    "recache": false,
    "position": "left",
    "chafa": {
      "fgOnly": false,
      "symbols": "block+border+space-wide-inverted",
    },
  },
  "display": { "separator": " " },
  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}",
    },
    { "key": "╭──  Software ──╮", "type": "custom" },

    { "key": "│ ├  Distro     │", "type": "os" },

    { "key": "│ ├  Kernel     │", "type": "kernel" },
    { "key": "│ ├ 󰧨 Compositor │", "type": "wm" },
    {
      "key": "│ ├ 󰏖 Packages   │",
      "type": "packages",
    },
    {
      "key": "│ ├  System Age │",
      "type": "command",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days",
    },
    { "key": "│ └ 󰅐 Uptime     │", "type": "uptime" },
    { "key": "├── 󰌢 Computer ──┤", "type": "custom" },
    { "key": "│ ├  Main Board │", "type": "host", "format": "{5} {1} " },
    { "key": "│ ├ 󰍛 Processor  │", "type": "cpu", "showPeCoreCount": true },
    { "key": "│ ├ 󰢮 Graphics   │", "type": "gpu", "format": "{1} {2} @ {12}" },
    { "key": "│ ├ 󰑭 Memory     │", "type": "memory" },
    { "key": "│ └ 󰓡 Swap-ZRAM  │", "type": "swap" },
    { "key": "├───  Drives ───┤", "type": "custom" },
    { "key": "│ ├ 󰉉 NVMe Root  │", "type": "disk", "folders": "/" },
    { "key": "│ ├ 󰉉 NVMe Home  │", "type": "disk", "folders": "/home" },
    {
      "key": "│ ├ 󰉉 SSD  Steam │",
      "type": "disk",
      "folders": "/mnt/Steam",
    },
    {
      "key": "│ ├ 󰉉 SSD  Games │",
      "type": "disk",
      "folders": "/mnt/Games",
    },
    {
      "key": "│ └ 󰉉 SSD  Data  │",
      "type": "disk",
      "folders": "/mnt/Data",
    },
    { "key": "╰────────────────╯", "type": "custom" },
    { "key": "    Colors    ", "type": "colors", "symbol": "circle" },
  ],
}
